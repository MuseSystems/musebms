defmodule <%= module_name %> do
  @external_resource "README.md"
  @moduledoc Path.join([__DIR__, "..", "..", "README.md"])
             |> File.read!()
             |> String.split("<!-- MDOC !-->")
             |> Enum.fetch!(1)

  @doc """
  Hello world.

  ## Examples

      iex> <%= module_name %>.hello()
      :world

  """
  def hello do
    :world
  end
end
