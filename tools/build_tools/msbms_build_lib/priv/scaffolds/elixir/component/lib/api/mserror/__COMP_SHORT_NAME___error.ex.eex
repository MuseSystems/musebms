defmodule Mserror.<%= module_short_name %>Error do
  @moduledoc """
  Defines an `Mserror` compliant error module for the <%= module_name %> component.

  For more see the `<%= module_name %>` Component documentation.
  """

  use MscmpSystError,
    component: <%= module_name %>,
    kinds: [
      error_kind: "An <%= comp_name %> error kind."
    ]
end
